{
  "name": "@courtvision/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "synth": "npm run build -w @courtvision/agentcore-runtime && cdk synth",
    "deploy": "cdk deploy --all --region us-east-1"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "aws-cdk": "^2.1031.1",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6"
  }
}
