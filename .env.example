# 本地视觉服务数据目录（可选）
COURTVISION_LOCAL_DATA=.local-data
COURTVISION_VISION_MODEL=yolo11n.pt
COURTVISION_TRACKING_FPS=10
COURTVISION_MODEL_SIZE=640
COURTVISION_PLAYER_MIN_CONFIDENCE=0.35
COURTVISION_BALL_MIN_CONFIDENCE=0.30
COURTVISION_SCOREBOARD_INTERVAL_SECONDS=3
COURTVISION_PLAYER_CLASS_ID=0
COURTVISION_BALL_CLASS_ID=32
COURTVISION_DETECTOR_CLASSES=0,32

# 本地前端调用已部署 AWS API 时使用；CloudFront 上默认走同源 /api
VITE_API_URL=https://7f18em0yq4.execute-api.us-east-1.amazonaws.com
