# 本地视觉服务数据目录（可选）
COURTVISION_LOCAL_DATA=.local-data
COURTVISION_VISION_MODEL=yolo11s.pt
COURTVISION_TRACKING_FPS=12
# GPU 默认 960；没有 CUDA 时建议改为 640，避免处理速度过慢。
COURTVISION_MODEL_SIZE=960
COURTVISION_PLAYER_MIN_CONFIDENCE=0.45
COURTVISION_BALL_MIN_CONFIDENCE=0.18
COURTVISION_SCOREBOARD_INTERVAL_SECONDS=3
COURTVISION_MIN_TRACK_SECONDS=0.65
COURTVISION_TRACK_MERGE_GAP_SECONDS=0.9
COURTVISION_TEAM_CLUSTER_MIN_DISTANCE=38
COURTVISION_AUTO_REFEREE_FILTER=1
COURTVISION_PLAYER_CLASS_ID=0
COURTVISION_BALL_CLASS_ID=32
COURTVISION_DETECTOR_CLASSES=0,32
